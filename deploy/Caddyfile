# HTTPS for both sites; certificates come from Let's Encrypt automatically.

# API (this repository)
tohfaah.online, www.tohfaah.online {
	encode gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy api:80
}

# Website (frontend repository; its "web" container is on the shared "cafechalao" network)
tohfaah.com, www.tohfaah.com {
	encode gzip
	reverse_proxy web:3000
}
