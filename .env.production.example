# CafeChalao API, production (https://tohfaah.online). Copy to .env.production on the server and fill the blanks.
# Generate APP_KEY once with: docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_NAME=CafeChalao
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://tohfaah.online
APP_TIMEZONE=UTC
CAFE_TIMEZONE=Asia/Kolkata

# Only the café's website may call the API from a browser.
CORS_ALLOWED_ORIGINS=https://tohfaah.com,https://www.tohfaah.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL runs in the "db" container (docker-compose.prod.yml); use the same values there.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cafechalao
DB_USERNAME=cafechalao
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
# Nothing is queued in this version, so jobs run straight away.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# Demo for showing clients: sign-in codes are always DEMO_OTP and are shown on screen.
# Set DEMO_MODE=false once a real SMS provider is connected.
DEMO_MODE=true
DEMO_OTP=123456

# Optional: real "Continue with Google" for guests (Google Cloud OAuth client for https://tohfaah.com).
GOOGLE_CLIENT_ID=
